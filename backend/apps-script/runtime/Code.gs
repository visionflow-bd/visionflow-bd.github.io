// doGet: non-sensitive health — returns ContentService JSON
function doGet(e) {
  var result = workerDoGet(e, { config: loadConfig_runtime() });
  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

// doPost: fails closed — returns ContentService JSON
function doPost(e) {
  var result = workerDoPost(e, { config: loadConfig_runtime(), firestore: null });
  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

// Scheduled worker — called by time-driven trigger (NOT auto-created)
async function scheduledWorker() {
  var config = loadConfig_runtime();
  if (config.enabled !== true) {
    Logger.log('Worker disabled. Set ENABLED=true in Script Properties after verification.');
    return { disabled: true };
  }
  if (!validateConfig(config).valid) throw new Error('Worker configuration incomplete.');
  var firestore = createFirestoreAdapter_runtime();
  var mail = createMailAdapter_runtime(firestore);
  var clock = createClockAdapter();

  // Process outbox events
  var outboxResult = await processOutbox({ firestore: firestore, mail: mail, clock: clock, config: config });
  Logger.log('Outbox: ' + JSON.stringify({ ok: outboxResult.ok, processed: outboxResult.processed }));

  // Process review timers
  var reviewResult = await settleReviewTimers({ firestore: firestore, clock: clock, config: config });
  Logger.log('Reviews: ' + JSON.stringify({ processed: reviewResult.processed }));
  return { outbox: outboxResult, reviews: reviewResult };
}

// ── Runtime adapter constructors (use real Apps Script globals) ────
function createFirestoreAdapter_runtime() {
  return createFirestoreAdapter({
    urlFetch: UrlFetchApp,
    scriptApp: ScriptApp,
    projectId: PropertiesService.getScriptProperties().getProperty('PROJECT_ID') || '',
  });
}

function createMailAdapter_runtime(firestore) {
  var adapter = createMailAdapter({ mailApp: MailApp, session: typeof Session === 'undefined' ? null : Session, expectedSender: loadConfig_runtime().expectedSender,
    paymentAttachment: function(document) { firestore.checkBudget(); return createPaymentAttachment(document, {urlFetch: UrlFetchApp, utilities: Utilities, htmlService: HtmlService}); }
  });
  return {
    readiness: adapter.readiness,
    remainingQuota: adapter.remainingQuota,
    send: async function(message) { firestore.checkBudget(); return await adapter.send(message); }
  };
}

function loadConfig_runtime() {
  return loadConfig({ propertiesService: PropertiesService });
}

// Owner/editor-only diagnostic; never called by the public web handlers.
async function ownerReadinessCheck() {
  var report = await inspectRuntimeReadiness({
    config: loadConfig_runtime(), firestore: createFirestoreAdapter_runtime(),
    scriptApp: ScriptApp, session: Session, mailApp: MailApp
  });
  Logger.log(JSON.stringify(report));
  return report;
}

